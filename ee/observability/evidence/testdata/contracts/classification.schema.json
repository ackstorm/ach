{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal work classification response",
  "type": "object",
  "required": [
    "window",
    "provenance",
    "taxonomy",
    "categories",
    "coverage"
  ],
  "properties": {
    "window": {
      "type": "object",
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "timezone": {
          "const": "UTC"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "state",
        "reason",
        "sampled"
      ],
      "properties": {
        "state": {
          "enum": [
            "available",
            "derived",
            "partial",
            "not_instrumented"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sampled": {
          "type": "boolean"
        },
        "coverage": {
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "observed_start": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "type": "string"
        },
        "grain": {
          "type": "string"
        }
      }
    },
    "taxonomy": {
      "const": "v3"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "domain",
          "sessions",
          "generations",
          "input_tokens",
          "output_tokens",
          "cost"
        ],
        "properties": {
          "category": {
            "type": "string",
            "pattern": "^[a-z_]+(\\.[a-z_]+)?$"
          },
          "domain": {
            "type": "string"
          },
          "sessions": {
            "type": "integer",
            "minimum": 1
          },
          "generations": {
            "type": "integer",
            "minimum": 0
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "cost": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "coverage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "sessions",
            "labelled",
            "share",
            "sessionless_generations"
          ],
          "properties": {
            "sessions": {
              "type": "integer",
              "minimum": 0
            },
            "labelled": {
              "type": "integer",
              "minimum": 0
            },
            "share": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "sessionless_generations": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
