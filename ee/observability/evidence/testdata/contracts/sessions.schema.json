{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal sessions response",
  "description": "The caller's sessions (generations grouped by project and session_id) in the window. One turn = one trace = one gateway request.",
  "type": "object",
  "required": [
    "window",
    "sessions",
    "next_cursor",
    "total_count",
    "sessionless_traces",
    "provenance"
  ],
  "properties": {
    "window": {
      "type": "object",
      "required": [
        "start",
        "end",
        "timezone"
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "session_id",
          "project_id",
          "started_at",
          "last_activity_at",
          "duration_ms",
          "turns",
          "generations",
          "input_tokens",
          "output_tokens",
          "cost",
          "models",
          "status"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_activity_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "turns": {
            "type": "integer",
            "minimum": 1
          },
          "generations": {
            "type": "integer",
            "minimum": 1
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 3
          },
          "status": {
            "enum": [
              "error",
              "unknown"
            ],
            "description": "error: any generation logged ERROR; otherwise unknown (the gateway does not observe task success)."
          }
        }
      }
    },
    "next_cursor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "All of the caller's sessions in the window, before pagination; null when the source is unavailable."
    },
    "sessionless_traces": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "The caller's traces in the window with no session id; null when that count failed."
    },
    "provenance": {
      "type": "object",
      "required": [
        "state",
        "reason",
        "sampled"
      ],
      "properties": {
        "state": {
          "enum": [
            "available",
            "derived",
            "partial",
            "not_instrumented"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sampled": {
          "type": "boolean"
        },
        "coverage": {
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "observed_start": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "type": "string"
        },
        "grain": {
          "type": "string"
        }
      }
    }
  }
}
